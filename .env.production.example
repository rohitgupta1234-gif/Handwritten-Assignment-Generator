# ===========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env.production and fill in all values
# NEVER commit .env.production to version control!
# ===========================================

# -------------------------------------------
# APPLICATION SETTINGS
# -------------------------------------------
NODE_ENV=production
PORT=5000

# Frontend URL (must match your production domain)
FRONTEND_URL=https://your-domain.com

# -------------------------------------------
# DATABASE
# -------------------------------------------
# SQLite file path (for sql.js/WASM)
DATABASE_PATH=./data/app.db

# -------------------------------------------
# REDIS (for job queues, rate limiting, sessions)
# -------------------------------------------
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# -------------------------------------------
# JWT AUTHENTICATION
# -------------------------------------------
# MUST be a strong random string (min 32 chars)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production

# Token expiry times
# Access token: short-lived for security
# Refresh token: longer-lived for session persistence
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# -------------------------------------------
# AI PROVIDER CONFIGURATION
# -------------------------------------------
# Primary AI provider: 'gemini' or 'openai'
AI_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=60000

# OpenAI API (fallback)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TIMEOUT=60000

# -------------------------------------------
# FILE UPLOAD
# -------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes

# -------------------------------------------
# EMAIL / SMTP (for notifications)
# -------------------------------------------
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@your-domain.com

# -------------------------------------------
# STABLE DIFFUSION FORGE (optional - for realistic handwriting)
# -------------------------------------------
FORGE_API_URL=http://your-forge-host:7860
FORGE_TIMEOUT=120000
FORGE_HEALTH_CHECK_INTERVAL=30000
FORGE_MAX_RETRIES=3
FORGE_RETRY_DELAY=2000
FORGE_DEFAULT_MODEL=your-model-name
FORGE_CONTROLNET_MODEL=control_v11p_sd15_canny

# -------------------------------------------
# RATE LIMITING
# -------------------------------------------
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# -------------------------------------------
# LOGGING & MONITORING
# -------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=your-sentry-dsn  # Optional: for error tracking

# -------------------------------------------
# CORS & SECURITY
# -------------------------------------------
# Comma-separated list of allowed origins (for production, specify exact domains)
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# -------------------------------------------
# PDF/DOCX GENERATION
# -------------------------------------------
# Puppeteer may need additional system dependencies in production
# See: https://github.com/puppeteer/puppeteer/blob/main/docs/troubleshooting.md